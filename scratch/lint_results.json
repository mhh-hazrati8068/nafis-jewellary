 getProductMaterial } from \"@/lib/dynamicTranslator\";\n\nexport default function CollectionsPage() {\n  const { products, language, addToCart, t } = useAppStore();\n\n  const collections = [\n    {\n      id: \"rings\",\n      titleFa: \"┌ر╪د┘┌ر╪┤┘ ╪د┘┌»╪┤╪ز╪▒┘ç╪د█î █▒█╕ ╪╣█î╪د╪▒ ┘ê ┘┘é╪▒┘ç\",\n      titleEn: \"Fine Gold & Silver Ring Collection\",\n      titleAr: \"┘à╪ش┘à┘ê╪╣╪ر ╪«┘ê╪د╪ز┘à ╪د┘╪░┘ç╪ذ ╪╣┘è╪د╪▒ 18 ┘ê╪د┘┘╪╢╪ر\",\n      subtitleFa: \"┘╛█î┘ê┘╪» ╪│┘┌» ╪╣┘é█î┘é ┘ê ╪د┘┘à╪د╪│ ┘╛╪د┌ر VVS\",\n      subtitleEn: \"VVS Diamond & Natural Agate Fusion\",\n      subtitleAr: \"╪ز┘╪د╪║┘à ╪د┘╪╣┘é┘è┘é ╪د┘╪╖╪ذ┘è╪╣┘è ┘ê╪د┘╪ث┘┘à╪د╪│ ╪د┘┘┘é┘è\",\n      descriptionFa: \"┘à╪ش┘à┘ê╪╣┘çظî╪د█î ╪ذ╪د╪┤┌ر┘ê┘ç ╪د╪▓ ╪د┘┌»╪┤╪ز╪▒┘ç╪د█î ╪»╪│╪زظî╪│╪د╪▓ ╪╖┘╪د█î ╪«╪د┘╪╡ █▒█╕ ╪╣█î╪د╪▒ ┘ê ┘┘é╪▒┘ç ┌ر┘ç ╪ذ╪د ╪د┘┘ç╪د┘à ╪د╪▓ ╪«╪╖┘ê╪╖ ┘à╪╣┘à╪د╪▒╪د┘┘ç ┘ç┘ê█î╪ز ╪ز╪╡┘ê█î╪▒█î ╪ذ╪▒┘╪» ┘┘█î╪│┘ç ╪╣╪ذ╪د╪»█î ╪«┘┘é ╪┤╪»┘çظî╪د┘╪».\",\n      descriptionEn: \"A magnificent collection of handcrafted solid 18K gold and fine silver rings inspired by the architectural guidelines of the Nafise Ebadi visual identity.\",\n      descriptionAr: \"╪ز╪┤┘â┘è┘╪ر ╪│╪د╪ص╪▒╪ر ┘à┘ ╪د┘╪«┘ê╪د╪ز┘à ╪د┘╪╡┘è╪د╪║╪ر ╪د┘┘è╪»┘ê┘è╪ر ╪ذ╪د┘╪░┘ç╪ذ ┘ê╪د┘┘╪╢╪ر ╪د┘┘┘é┘è╪ر ╪د┘┘à╪│╪ز┘ê╪ص╪د╪ر ┘à┘ ╪د┘┘à╪╣╪د┘è┘è╪▒ ╪د┘┘à╪╣┘à╪د╪▒┘è╪ر ┘┘┘ç┘ê┘è╪ر ╪د┘╪ذ╪╡╪▒┘è╪ر ┘┘à╪ش┘ê┘ç╪▒╪د╪ز ┘┘┘è╪│╪ر ╪╣╪ذ╪د╪»┘è.\",\n      image: \"https://images.unsplash.com/photo-1605100804763-247f66126e28?q=80&w=1000&auto=format&fit=crop\",\n      items: products.filter(p => p.category === 'rings')\n    },\n    {\n      id: \"necklaces\",\n      titleFa: \"┌ر╪د┘┌ر╪┤┘ ┌»╪▒╪»┘╪ذ┘╪» ┘ê ╪ت┘ê█î╪▓┘ç╪د█î ╪╣┘é█î┘é\",\n      titleEn: \"Necklace & Agate Pendant Collection\",\n      titleAr: \"┘à╪ش┘à┘ê╪╣╪ر ┘é┘╪د╪خ╪» ┘ê┘à╪»╪د┘┘è╪د╪ز ╪د┘╪╣┘é┘è┘é\",\n      subtitleFa: \"╪»╪▒╪«╪┤╪┤ ╪╖┘╪د█î ╪▓╪▒╪» ┘ê ╪│┘┌»ظî┘ç╪د█î ╪د╪╡┘\",\n      subtitleEn: \"Authentic Agate & Yellow Gold Elegance\",\n      subtitleAr: \"╪ذ╪▒┘è┘é ╪د┘╪░┘ç╪ذ ╪د┘╪ث╪╡┘╪